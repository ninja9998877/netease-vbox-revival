#!/bin/sh /etc/rc.common
# spkbrain —— 把网易三音云音箱接进家庭大脑（Tailscale 层）
#
# 二进制和 node key 在 /mnt/UDISK/spk（持久），运行时文件在 /tmp/spk（内存盘）。
# 真正的启动逻辑在 /mnt/UDISK/spk/run.sh —— 那里还负责补一条主表路由，
# 因为 kernel 3.4.39 的自动选路会忽略策略路由规则。
#
# 装：cp spkbrain /etc/init.d/spkbrain && chmod +x /etc/init.d/spkbrain
# 开：/etc/init.d/spkbrain enable && /etc/init.d/spkbrain start

START=95
STOP=95
USE_PROCD=1
DEPEND=network

start_service() {
	# ★★★ 必须等 UDISK 挂上再往下走（2026-09-21 血的教训）。
	#
	#   实测：S95spkbrain 比 UDISK 挂载【早 1 秒】开跑，这里的存在性检查失败就 return 1，
	#   于是整条链一个都没起来 —— tailscaled / spkclient / muxguard / nightmute 全丢，
	#   代价是音箱哑了一整夜：HP_L Mux 被指错（左声道断路）没人扳回来，音量也没人守。
	#   日志铁证（就差 1 秒）：
	#     05:09:15  spkbrain: /mnt/UDISK/spk 不在，跳过（UDISK 没挂上？）
	#     05:09:16  /dev/by-name/UDISK: clean, 114/15424 files, ...
	#
	#   不能靠调启动序号（挂载时机不固定，这次是 1 秒，下次未必），自己等最稳。
	#   正常只等 1~2 秒；真挂不上则最多等 30 秒后放弃，不至于卡死启动。
	i=0
	while [ ! -d /mnt/UDISK/spk ] && [ $i -lt 30 ]; do
		sleep 1
		i=$((i+1))
	done
	if [ ! -d /mnt/UDISK/spk ]; then
		echo "spkbrain: 等了 30 秒 /mnt/UDISK/spk 还没出现，放弃（UDISK 真没挂上？）"
		return 1
	fi
	[ "$i" -gt 0 ] && echo "spkbrain: 等了 ${i}s 才等到 UDISK（竞态已兜住）"

	# ---- 第一层：Tailscale（给音箱一条能回 mac mini 的路）----
	if [ -x /mnt/UDISK/spk/tailscaled ]; then
		procd_open_instance tailscaled
		procd_set_param command /bin/sh /mnt/UDISK/spk/run.sh
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# ---- 第二层：spkclient —— ★★★ 已拆，别再加回来（2026-09-22）----
	#
	#   它原来是"把 DBus 上发生的事按行转给 mac mini:9999"的哑管道。拆掉是因为
	#   **那头没了**：macmini 的接收方（server.py / spkbrain-voice.service）早已
	#   inactive/disabled，9999 上【没有任何监听】⇒ 它变成一条每 5 秒撞一次墙的
	#   死循环。实测（设备 tailscaled 日志，连续刷）：
	#       socks5: client connection failed: dial tcp 192.168.1.100:9999: connection refused
	#       open-conn-track: flow TCP (TCP 192.168.1.50:xxxxx => 192.168.1.100:9999) got RST by peer
	#   （192.168.1.100 = 跑"大脑"的那台机器，192.168.1.50 = 这台音箱，以你的实际部署为准）
	#
	#   代价不是"白跑"：它把 tailscaled 的日志刷到 **2.2MB**（日志在 /tmp = tmpfs，
	#   吃的是内存），并触发 tailscaled 自己的 `[RATELIMIT]` ⇒ **把真信号淹掉**——
	#   排障时 tail 那个日志，后面全是这两行，看不到别的。
	#
	#   它原本的功能【全部有现役替代】：
	#     认唤醒 → waketap.sh 抄设备引擎的答案 → macmini:9997（设备 8/8，我们抄它）
	#     说话   → play601.sh 发 0x601 给 netease.ihw.player
	#     耳朵   → mictap.so → macmini:9998
	#     收发命令 → spk_net.sh 轮询 macmini:8898（这条是活的，8898 在听）
	#
	#   ★ 二进制【没删】：/mnt/UDISK/spk/spkclient 还在，随时可回退。
	#     回退 = 把下面这段 if 块贴回 start_service() 里 + `/etc/init.d/spkbrain restart`：
	#         if [ -x /mnt/UDISK/spk/spkclient ]; then
	#                 procd_open_instance spkclient
	#                 procd_set_param command /mnt/UDISK/spk/spkclient
	#                 procd_set_param respawn 3600 5 5
	#                 procd_set_param stdout 1
	#                 procd_set_param stderr 1
	#                 procd_close_instance
	#         fi
	#     ★★ 但回退的前提是**先在 macmini 上把 9999 的接收端架起来** ——
	#        光把这段加回来，只是把死循环请回来（2026-09-22 之前一直是这样）。
}
