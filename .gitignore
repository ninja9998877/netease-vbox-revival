# ══════════════════════════════════════════════════════════════
#  开源仓库 .gitignore
#  原则：我们的代码和文档进仓库；别人的版权物、家里的隐私、
#        密钥、大二进制 — 一律不进，只在文档里写清来源。
# ══════════════════════════════════════════════════════════════

# ── ★ 密钥与证书（最高优先级）────────────────────────────────
# probeca/ 里是拦截用的 CA 私钥 + 服务器私钥。
# 流出去 = 送人一把 MITM 钥匙。★ 绝不入库，文档里教人本地现生成。
probeca/
*.key
*.pem
*.crt
*.csr
*.srl
.qwen_key
*_key
*.key.*
deepseek.key
spk.key

# ── ★ 家庭隐私（语音 / 记忆 / 会话）──────────────────────────
# mem/ 含家庭事实、对话归档、声纹向量
# session/ 含当前会话上下文
# spec/ 和 wakeword/ 含真人的录音样本
mem/
session/
spec/
wakeword/
faces/
capture/
log/
audio/
music/
filler/

# ── ★ 他人版权物（绝不分发）──────────────────────────────────
# apk/ 是反编译厂商 App 的产物（含其 Java 源码与原生库）
apk/
# 原厂固件 / 原厂音效素材
ding/
duilite/
rom/
firmware/

# ── ★ 大文件（读者自备，仓库只写来源）────────────────────────
# ASR / KWS 模型
asr/
# 依赖与虚拟环境
node_modules/
.venv/
venv/
# 第三方二进制（含代理/VPN 客户端）
ts/
ncmcli/
ncm-bin/

# ── 历史快照（可能残留已移除的密钥/数据）────────────────────
*.bak
*.bak-*
*.bak.*
*.old
*.orig
*.pre-*
*~

# ── 运行期产物 ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.log
*.pid
*.lock
*.tmp
.tmp/
/tmp/
*.db
*.sqlite
*.sqlite3
*.jsonl

# ── 编译产物（读者自己编，不入库）────────────────────────────
mictap.so
noyunxin.so
fespatap.so
*.so
*.o
*.a
# ★ 显式放行源码 —— 上面那几条通配符很容易误伤到 .c/.h
!device/*.c
!device/*.h

# ★ 关于 device/mictap_filt.h：它是 design_filter.py 生成的，但**必须进仓库**——
#   它的系数是从**设备上的一份真录音**里量出来的，读者手里没有那份录音就复现不了，
#   不带上它 mictap.c 直接编不过。理由记在这儿，免得以后有人"顺手"把它 ignore 掉。

# ── 环境与编辑器 ────────────────────────────────────────────
.env
.env.*
.DS_Store
.vscode/
.idea/
*.swp

# ── 例外：这些 example 模板要进仓库 ─────────────────────────
!*.example
!**/*.example

# ── 本项目配置层（★ 真值绝不进仓库）─────────────────────────
config/spk.env
device/spk.conf
src/spk.env
