# ★ 部署前必改：
#   User=      改成你跑这个服务的账号
#   WorkingDirectory= / ExecStart= 里的 /opt/spkbrain 改成你实际的路径
[Unit]
Description=音箱求救管道 · 出方案 → 等使用者点头 → 才执行（授权门禁在这条链上）
Documentation=file:///opt/spkbrain/spk_helpd.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spkbrain
WorkingDirectory=/opt/spkbrain
ExecStart=/usr/bin/python3 /opt/spkbrain/spk_helpd.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# ★ 必须显式给 PATH：claude 装在 ~/.npm-global/bin，systemd 默认的 PATH 里没有它，
#   少了这一行会表现成"方案永远出不来"，而日志看着像模型不听话。
Environment=PATH=/home/spkbrain/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
