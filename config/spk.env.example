# ══════════════════════════════════════════════════════════════
#  本机（跑"大脑"的那台）配置
#
#  用法：把本文件抄成同目录的 spk.env，改掉里面的值。
#  ★ spk.env 已被 .gitignore 拦住，不会进仓库。
#  ★ 优先级：环境变量 > spk.env > 代码里的默认值。
# ══════════════════════════════════════════════════════════════

# ── 跑大脑的这台机器，设备要能连上它 ────────────────────────
# ★ 填这台机器在【你家局域网里】的地址，不是 127.0.0.1
#   （除非设备和大脑是同一台机器）
SPK_HOST=192.168.1.100

# ── 你那台音箱的地址（不用就留空）───────────────────────────
SPK_DEVICE_IP=

# ── 端口（改了要跟设备侧 spk.conf 对上）─────────────────────
SPK_PORT_MP3=8899
SPK_PORT_NETD=8898
SPK_PORT_TTS=8896
SPK_PORT_MICTAP=9998

# ── 数据目录 ────────────────────────────────────────────────
# 记忆、会话、日志都落这儿。留空 = 用仓库根目录。
SPK_DATA_DIR=

# ── 大模型（"脑子"）────────────────────────────────────────
# ★ 端点可以换任意兼容的服务；换模型只改这两行。
DS_BASE=https://api.deepseek.com/anthropic
SPK_LLM_MODEL=deepseek-chat

# ★★ 密钥【不写在这个文件里】，用环境变量传：
#     export SPK_LLM_KEY=...
#   或者在 systemd 的 service 里用 EnvironmentFile= 指一个 0600 的文件。
#   为什么：这个文件是给人抄的，抄的时候最容易连着密钥一起抄进仓库。

# ── 语音合成（"嗓子"）──────────────────────────────────────
# qwen = 阿里通义千问；edge = 微软 edge-tts（免费兜底）
SPK_TTS_ENGINE=qwen
SPK_QWEN_VOICE=Maia
# 若用 qwen，密钥同样走环境变量：export SPK_QWEN_KEY=...

# ── 闹钟放什么歌 ────────────────────────────────────────────
# ★ 填**你自己**的网易云歌单 ID（网页版地址栏 playlist?id= 后面那一串）。
#   不填 = 闹钟照响，但没音乐。
SPK_ALARM_PLAYLIST=

# ── 只允许哪些来源连本机的服务（CIDR，逗号分隔）─────────────
# 默认已含本机 + 三段私有网 + 运营商级 NAT 段，一般不用动。
# 想收紧就写你自己的网段，例如 SPK_LAN_CIDR=192.168.1.0/24
SPK_LAN_CIDR=

# ── 设备侧路径（一般不用改）─────────────────────────────────
SPK_DEVICE_DIR=/mnt/UDISK/spk
SPK_DEVICE_TMP=/tmp/spk
